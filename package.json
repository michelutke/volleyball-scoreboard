		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"license-checker": "^25.0.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.3",
