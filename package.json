		"lucide-svelte": "^1.0.1",
		"motion": "^12.38.0",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"satori": "0.62.0",
		"stripe": "^23.0.0",
		"zod": "^4.6.5"
	},
	"overrides": {
		"cookie": "^0.7.2"
